{
  "name": "gaviota-by-lia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run tests/unit/rls.test.ts",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:stop:clean": "supabase stop --no-backup",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "node scripts/db-remote.mjs test",
    "db:lint": "supabase db lint --level error",
    "db:types": "supabase gen types typescript --local > src/types/database.types.ts",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "db:verify": "npm run db:reset && npm run db:test && npm run db:lint",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:setup": "node scripts/supabase-setup.mjs",
    "db:seed": "node scripts/db-remote.mjs seed",
    "db:sql": "node scripts/db-remote.mjs sql"
  },
  "dependencies": {
    "@paypal/paypal-server-sdk": "^2.4.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.28.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "stripe": "^22.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^3.2.0",
    "dotenv": "^17.2.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "^16.0.0",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "prettier": "^3.6.0",
    "sharp": "^0.35.3",
    "supabase": "^2.48.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
