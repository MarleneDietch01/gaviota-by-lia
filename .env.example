# =============================================================================
# Gaviota by Lia — Variables de entorno
# =============================================================================
# Copia este archivo a .env.local y rellena los valores.
# NUNCA incluyas valores reales en este archivo ni lo subas con secretos.
#
# Regla de oro: solo las variables NEXT_PUBLIC_* llegan al navegador.
# Cualquier otra es secreta y vive únicamente en el servidor.
# =============================================================================

# --- Sitio --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase -----------------------------------------------------------------
# URL y clave anónima: públicas por diseño, protegidas por RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETO. Salta todas las políticas RLS.
# Solo se usa en servidor (webhooks, cron, operaciones administrativas).
# Si esta clave llega al navegador, la base de datos queda completamente expuesta.
# El archivo src/lib/supabase/admin.ts importa 'server-only' para impedirlo.
SUPABASE_SERVICE_ROLE_KEY=

# Conexión directa a Postgres. Solo para migraciones y pruebas RLS.
DATABASE_URL=

# ID del proyecto Supabase, para `npm run db:types`
SUPABASE_PROJECT_ID=

# --- Pagos (legado, sin usar por el checkout de Stripe) -----------------------
# mock | stripe | paypal | ...
# El despliegue de producción FALLA si vale "mock" (ver scripts/check-env.ts).
PAYMENT_PROVIDER=mock
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Stripe ---------------------------------------------------------------
# Dashboard de Stripe (modo TEST para desarrollo) -> Developers -> API keys
STRIPE_SECRET_KEY=
# Developers -> Webhooks -> tu endpoint -> Signing secret (empieza por whsec_)
# En local, usa el Stripe CLI: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# --- PayPal ------------------------------------------------------------------
# developer.paypal.com -> Apps & Credentials -> modo Sandbox -> tu app
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# --- Envío ---------------------------------------------------------------------
# Fallback usado por computeShipping() (lib/commerce/checkout.ts) SOLO cuando
# shipping_rates no tiene ninguna fila activa para US/todo el país — hoy no
# tiene ninguna. No hay valor de ejemplo a propósito: no se inventa una
# tarifa. En centavos (ej. 995 = $9.95). check-env.mjs exige esta variable en
# cualquier build de producción.
SHIPPING_FLAT_RATE_CENTS=
# Envío gratis a partir de este subtotal, en centavos. Vacío = desactivado
# (comportamiento por defecto: no se inventa un umbral). Solo se usa si
# shipping_rates tampoco tiene un free_above en la fila activa.
FREE_SHIPPING_THRESHOLD_CENTS=

# --- Correo transaccional (Resend) --------------------------------------------
# Requiere dominio propio verificado con SPF/DKIM/DMARC.
# No se puede enviar desde gmail.com. Ver MIGRATION_RISKS.md R14.
RESEND_API_KEY=
EMAIL_FROM=
# A dónde llega la notificación de "nueva venta" (src/lib/email/order-confirmation.ts).
# Vacío = no se manda notificación a nadie, pero el recibo de la clienta sigue
# saliendo igual — son dos envíos independientes.
ADMIN_EMAIL=

# --- Analítica (opcional, requiere consentimiento) ----------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=

# --- Seguridad ----------------------------------------------------------------
# Protege los endpoints /api/cron/*. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Clave de cifrado para datos sensibles en reposo (32 bytes en hex).
ENCRYPTION_KEY=

# --- Solo para pruebas RLS (nunca en producción) ------------------------------
# Credenciales de usuarios de prueba creados por los seeds de desarrollo.
TEST_CUSTOMER_A_EMAIL=
TEST_CUSTOMER_A_PASSWORD=
TEST_CUSTOMER_B_EMAIL=
TEST_CUSTOMER_B_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
